# The host-specific half: these examples drive a cPanel account. They will not
# run as-is against a different control panel - replace them with your host's
# equivalent and keep everything else.
ACCOUNT_HOME=/home/youruser
ACME_HOME="$ACCOUNT_HOME/.acme.sh"
ACCOUNT_CONF="$ACME_HOME/account.conf"
CPANEL_USER=youruser
